msgid "Products"
msgstr "المنتجات"

#. module: material_request
#: model:ir.model.fields,field_description:material_request.field_material_request__product_ids
msgid "Requested Products"
msgstr "المنتجات المطلوبة"

#. module: material_request
#: model:ir.model.fields,help:material_request.field_material_request__product_ids
msgid "Products of the request lines, for search and display."
msgstr "منتجات أسطر الطلب، للبحث والعرض."

#. module: material_request
#: model:ir.model.fields,field_description:material_request.field_material_request__notes
msgid "Notes"
msgstr "ملاحظات"

#. module: material_request
#: model:ir.model.fields,field_description:material_request.field_material_request__picking_out_id
msgid "Shipping Transfer"
msgstr "تحويل الإرسال"

#. module: material_request
#: model:ir.model.fields,help:material_request.field_material_request__picking_out_id
msgid "First leg: from the source branch to the transit location."
msgstr "المرحلة الأولى: من الفرع المصدر إلى موقع العبور."

#. module: material_request
#: model:ir.model.fields,field_description:material_request.field_material_request__picking_in_id
msgid "Receiving Transfer"
msgstr "تحويل الاستلام"

#. module: material_request
#: model:ir.model.fields,help:material_request.field_material_request__picking_in_id
msgid ""
"Latest leg created: from the transit location to the requesting branch. "
"Partial shipments create one receiving transfer per leg."
msgstr ""
"آخر مرحلة تم إنشاؤها: من موقع العبور إلى الفرع الطالب. تنشئ الإرسالات "
"الجزئية تحويل استلام لكل مرحلة."

#. module: material_request
#: model:ir.model.fields,field_description:material_request.field_material_request__picking_ids
msgid "Transfers"
msgstr "التحويلات"

#. module: material_request
#: model:ir.model.fields,field_description:material_request.field_material_request__picking_count
msgid "Transfers Count"
msgstr "عدد التحويلات"

#. module: material_request
#: model:ir.model.fields,field_description:material_request.field_material_request__purchase_order_id
msgid "Purchase Order"
msgstr "أمر شراء"

#. module: material_request
#: model:ir.model.fields,help:material_request.field_material_request__purchase_order_id
msgid "Draft RFQ created when a Purchase Request is approved."
msgstr "طلب عرض أسعار (مسودة) يُنشأ عند الموافقة على طلب الشراء."

