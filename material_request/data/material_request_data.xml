<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Sequence for the material requests -->
        <record id="seq_material_request" model="ir.sequence">
            <field name="name">Material Request</field>
            <field name="code">material.request</field>
            <field name="prefix">MR/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Dedicated transit location used by every branch transfer:
             source branch -> transit -> requesting branch.  Shared between
             companies (company_id = False) so it works in any branch of any
             company, like Odoo's own inter-company transit location. -->
        <record id="stock_location_material_transit" model="stock.location">
            <field name="name">Internal Transfer Transit</field>
            <field name="usage">transit</field>
            <field name="company_id" eval="False"/>
            <field name="active" eval="True"/>
        </record>

    </data>
</odoo>
